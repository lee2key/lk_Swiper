{
  "name": "lk_swiper",
  "version": "1.0.0",
  "description": "A local Windows desktop app for ranking photos through head-to-head choices.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.swiper",
    "productName": "lk_Swiper",
    "icon": "build/icon.ico",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "logo.svg"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": "portable"
    }
  }
}
